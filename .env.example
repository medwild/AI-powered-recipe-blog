# =============================================================================
# Variables d'environnement — AI Blog Builder
# =============================================================================
# Copier ce fichier en .env.local et remplir les valeurs.
#   cp .env.example .env.local
#
# Certaines variables ont des valeurs par défaut qui fonctionnent en
# développement. Les variables REQUISES doivent être impérativement renseignées.
# =============================================================================

# ---------------------------------------------------------------------------
# BASE DE DONNÉES
# ---------------------------------------------------------------------------

# REQUIS — URL de connexion PostgreSQL (Neon, Supabase, Render, etc.)
# Exemple postgres://user:password@host:5432/dbname
DATABASE_URL=

# ---------------------------------------------------------------------------
# SERP (Analyse Google — Serper.dev)
# ---------------------------------------------------------------------------

# REQUIS — Clé API Serper.dev (https://serper.dev)
# Utilisé pour analyser les résultats Google pour le mot-clé cible.
SERPER_API_KEY=

# ---------------------------------------------------------------------------
# INTELLIGENCE ARTIFICIELLE (Cloudflare Workers AI)
# ---------------------------------------------------------------------------

# REQUIS — ID du compte Cloudflare (https://dash.cloudflare.com)
# Utilisé pour la génération de texte (Llama 3.1) et d'images (Stable Diffusion).
CLOUDFLARE_ACCOUNT_ID=

# REQUIS — Token API Cloudflare Workers AI
# Doit avoir les permissions "Workers AI: Run".
CLOUDFLARE_API_TOKEN=

# ---------------------------------------------------------------------------
# IA — LLM primaire (Anthropic Claude Sonnet 4.6)
# ---------------------------------------------------------------------------

# REQUIS — Clé API Anthropic (https://console.anthropic.com)
# Utilisé pour l'agent unique Chef Augustin (qualité d'écriture supérieure).
# Si absent, le workflow échoue — pas de fallback automatique.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# IA — LLM fallback (DeepSeek v4 Pro via proxy Anthropic-compatible)
# ---------------------------------------------------------------------------

# Optionnel — Configurer pour utiliser DeepSeek comme fallback si Anthropic indisponible.
# ANTHROPIC_BASE_URL=https://api.deepseek.com/v1
# ANTHROPIC_AUTH_TOKEN=<clé API DeepSeek>
# ANTHROPIC_MODEL=deepseek-v4-pro

# Optionnel — Modèle Anthropic (défaut: claude-sonnet-4-6)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ---------------------------------------------------------------------------
# IA — Génération d'images (Ideogram v4 Turbo)
# ---------------------------------------------------------------------------

# Optionnel — Clé API Ideogram (https://ideogram.ai)
# Utilisé pour la génération d'images food photography en 2:3 (Pinterest).
# Si absent, fallback automatique vers Cloudflare Workers AI (FLUX-1-Schnell).
# IDEOGRAM_API_KEY=

# ---------------------------------------------------------------------------
# HÉBERGEMENT D'IMAGES (Cloudinary)
# ---------------------------------------------------------------------------

# REQUIS — Cloud name Cloudinary (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=

# REQUIS — Clé API Cloudinary
CLOUDINARY_API_KEY=

# REQUIS — Secret API Cloudinary
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# FILE D'EXÉCUTION (Inngest)
# ---------------------------------------------------------------------------

# Optionnel — Clé de signature Inngest (automatique en local via Inngest Dev)
# Nécessaire en production pour sécuriser les requêtes.
# https://www.inngest.com/docs/reference/env-vars#inngest_signing_key
# INNGEST_SIGNING_KEY=

# Optionnel — Clé d'événement Inngest
# Généralement utilisée par le SDK client en production.
# https://www.inngest.com/docs/reference/env-vars#inngest_event_key
# INNGEST_EVENT_KEY=

# Dashboard auth — génère avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DASHBOARD_SECRET_TOKEN=

# Rate limiting (optionnel, défaut: 3 requêtes/min)
RATE_LIMIT_MAX_PER_MINUTE=3

# Paramètres géographiques SERP (défaut : us/en pour le marché anglophone)
SERP_GL=us
SERP_HL=en

# URL publique du site (utilisée pour sitemap, RSS, JSON-LD, OG metadata)
NEXT_PUBLIC_SITE_URL=https://chefaugustin.com

# Optionnel — URL du serveur Inngest Dev (surpasse http://127.0.0.1:8288)
# Utile si Inngest Dev tourne sur un port/hôte différent.
# INNGEST_DEV=http://127.0.0.1:8288

# ---------------------------------------------------------------------------
# AUTOPILOT — Publication automatique sans intervention humaine
# ---------------------------------------------------------------------------
# Active le mode autopilot : les validateurs deviennent warn-only (log, pas de blocage).
# La Content Loop (Evaluator-Optimizer) est le seul quality gate.
# Seules les erreurs structurelles (recette vide) et la similarité >60% bloquent encore.
AUTOPILOT=true

# ---------------------------------------------------------------------------
# AUTO-APPROVE — By-pass de la review humaine de 7 jours
# ---------------------------------------------------------------------------
AUTO_APPROVE=true

# ---------------------------------------------------------------------------
# GEO Validator thresholds — calibrés pour Claude Sonnet 4.6
# ---------------------------------------------------------------------------
# Valeurs par défaut (intégrées au code, modifiables via env) :
GEO_CLAIMS_MIN=6
GEO_ATTRIBUTIONS_MIN=4
GEO_NUGGETS_MIN=4
GEO_BLOCK_THRESHOLD=70
GEO_WARN_THRESHOLD=70
# Pour DeepSeek v4 Pro (qualité inférieure), baisser les seuils :
# GEO_CLAIMS_MIN=5
# GEO_ATTRIBUTIONS_MIN=2
# GEO_NUGGETS_MIN=2
# GEO_BLOCK_THRESHOLD=40
# GEO_WARN_THRESHOLD=55
# Content Loop — max 3 passes par recette (modifiable)
# LOOP_MAX_PASSES=3

# Science Enricher — Claude Sonnet 5 food science enrichment (default: true)
# Désactiver pour comparer les scores avec/sans enrichissement
# SCIENCE_ENRICHER_ENABLED=false

# Pre-Generation Gate — anti-duplicate & anti-cannibalization (default: true)
# Désactiver pour bypasser tous les checks (debug uniquement)
# PRE_GEN_GATE_ENABLED=false
# Seuil de similarité fuzzy PostgreSQL trigram (défaut: 0.8, range: 0.5-1.0)
# PRE_GEN_GATE_FUZZY_THRESHOLD=0.8
# Seuil de similarité sémantique Jaccard tokens (défaut: 0.7, range: 0.5-0.9)
# PRE_GEN_GATE_SEMANTIC_THRESHOLD=0.7
