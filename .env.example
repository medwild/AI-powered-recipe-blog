# =============================================================================
# Variables d'environnement — AI Blog Builder v14
# =============================================================================
# Copier ce fichier en .env.local et remplir les valeurs.
#   cp .env.example .env.local
# =============================================================================

# ---------------------------------------------------------------------------
# BASE DE DONNÉES
# ---------------------------------------------------------------------------

# REQUIS — URL de connexion PostgreSQL (Neon)
DATABASE_URL=

# ---------------------------------------------------------------------------
# SERP (Analyse Google — Serper.dev)
# ---------------------------------------------------------------------------

# REQUIS — Clé API Serper.dev (https://serper.dev)
SERPER_API_KEY=

# ---------------------------------------------------------------------------
# IA — LLM primaire (4 providers disponibles)
# ---------------------------------------------------------------------------
# Provider sélectionné via LLM_PROVIDER: "anthropic" | "deepseek" | "cloudflare" | "tokenmix" | "gemini" | "bai"
# ---------------------------------------------------------------------------

# --- Option 1: Anthropic (via ZenMux proxy) ---
# ZenMux est un proxy Anthropic-compatible. L'API est identique à api.anthropic.com.
# Base URL: https://zenmux.ai/api/anthropic
#
# Modèles disponibles sur ZenMux (2026-07-22) :
#   anthropic/claude-sonnet-5    ✅ Structured output + cache ephemeral
#   anthropic/claude-opus-4.8    ✅ Structured output + cache ephemeral
#
# ZenMux ne supporte PAS encore le paramètre `thinking` — le code le détecte
# automatiquement et le désactive.
#
# Pour utiliser Anthropic directement (sans ZenMux) :
#   ANTHROPIC_BASE_URL=https://api.anthropic.com
#   ANTHROPIC_MODEL=claude-opus-4-8

LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://zenmux.ai/api/anthropic
ANTHROPIC_MODEL=anthropic/claude-sonnet-5

# --- Option 2: Cloudflare Workers AI (gratuit — 10K Neurons/jour) ---
# Modèles recommandés pour la génération de contenu :
#   glm-5.2              → Meilleur rapport qualité/prix (EQ-Bench Creative 1742)
#   kimi-k2.6            → Second choix (EQ-Bench Creative 1722)
#   gpt-oss-120b         → Haute capacité, pas encore benchmarké en copywriting
#
# Pour activer Cloudflare :
#   LLM_PROVIDER=cloudflare
#   CLOUDFLARE_ACCOUNT_ID=votre_account_id
#   CLOUDFLARE_API_TOKEN=votre_api_token
#   CLOUDFLARE_MODEL=glm-5.2

# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_MODEL=glm-5.2

# --- Option 3: B.Ai (proxy OpenAI-compatible — provider `bai`) ---
# glm-5.3-flash, verdict Mega-Skill 01/09 (prose ≈ Opus, gate PASS).
# Streaming intégré (la gateway coupe le non-streaming à ~90 s).
# ⚠️ ANTHROPIC_MODEL doit matcher BAI_MODEL (le pipeline passe ANTHROPIC_MODEL
#    comme `model` à runText).
#   LLM_PROVIDER=bai
#   BAI_API_KEY=...
#   BAI_BASE_URL=https://api.b.ai
#   BAI_MODEL=glm-5.3-flash
#   ANTHROPIC_MODEL=glm-5.3-flash

# ---------------------------------------------------------------------------
# IA — Génération d'images (Ideogram ou FLUX-1)
# ---------------------------------------------------------------------------

# Optionnel — Clé API pour la génération d'images
# IDEOGRAM_API_KEY=

# ---------------------------------------------------------------------------
# HÉBERGEMENT D'IMAGES (Cloudinary)
# ---------------------------------------------------------------------------

# REQUIS — Cloudinary credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# DASHBOARD
# ---------------------------------------------------------------------------

DASHBOARD_SECRET_TOKEN=

# ---------------------------------------------------------------------------
# PUBLICATION
# ---------------------------------------------------------------------------

# URL publique du site (sitemap, RSS, JSON-LD, OG)
NEXT_PUBLIC_SITE_URL=https://chefaugustin.com

# Mode autopilot — publication automatique sans review humaine
AUTOPILOT=true

# By-pass review humaine de 7 jours
AUTO_APPROVE=true

# Rate limiting (défaut: 3 requêtes/min)
RATE_LIMIT_MAX_PER_MINUTE=3

# Paramètres géographiques SERP (défaut: us/en)
SERP_GL=us
SERP_HL=en

# ---------------------------------------------------------------------------
# DEBUG
# ---------------------------------------------------------------------------

# Optionnel — Active les logs détaillés
# DEBUG=true
