# =============================================================================
# Variables d'environnement — AI Blog Builder v14
# =============================================================================
# Copier ce fichier en .env.local et remplir les valeurs.
#   cp .env.example .env.local
# =============================================================================

# ---------------------------------------------------------------------------
# BASE DE DONNÉES
# ---------------------------------------------------------------------------

# REQUIS — URL de connexion PostgreSQL (Neon)
DATABASE_URL=

# ---------------------------------------------------------------------------
# SERP (Analyse Google — Serper.dev)
# ---------------------------------------------------------------------------

# REQUIS — Clé API Serper.dev (https://serper.dev)
SERPER_API_KEY=

# ---------------------------------------------------------------------------
# IA — LLM primaire (Claude Sonnet 5 via ZenMux)
# ---------------------------------------------------------------------------
# ZenMux est un proxy Anthropic-compatible. L'API est identique à api.anthropic.com.
# Base URL: https://zenmux.ai/api/anthropic
#
# Modèles disponibles sur ZenMux (2026-07-22) :
#   anthropic/claude-sonnet-5  ✅ Structured output + cache ephemeral
#   anthropic/claude-opus-4    ⚠️ Pas de structured output
#
# ZenMux ne supporte PAS encore le paramètre `thinking` — le code le détecte
# automatiquement et le désactive.
#
# Pour utiliser Anthropic directement (sans ZenMux) :
#   ANTHROPIC_BASE_URL=https://api.anthropic.com
#   ANTHROPIC_MODEL=claude-opus-4-8

LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://zenmux.ai/api/anthropic
ANTHROPIC_MODEL=anthropic/claude-sonnet-5

# ---------------------------------------------------------------------------
# IA — Génération d'images (Ideogram ou FLUX-1)
# ---------------------------------------------------------------------------

# Optionnel — Clé API pour la génération d'images
# IDEOGRAM_API_KEY=

# ---------------------------------------------------------------------------
# HÉBERGEMENT D'IMAGES (Cloudinary)
# ---------------------------------------------------------------------------

# REQUIS — Cloudinary credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# INNGEST — Background jobs
# ---------------------------------------------------------------------------

# Optionnel — Clé de signature Inngest (obligatoire en production)
# INNGEST_SIGNING_KEY=
# INNGEST_EVENT_KEY=

# Dashboard auth
DASHBOARD_SECRET_TOKEN=

# ---------------------------------------------------------------------------
# PUBLICATION
# ---------------------------------------------------------------------------

# URL publique du site (sitemap, RSS, JSON-LD, OG)
NEXT_PUBLIC_SITE_URL=https://chefaugustin.com

# Mode autopilot — publication automatique sans review humaine
AUTOPILOT=true

# By-pass review humaine de 7 jours
AUTO_APPROVE=true

# Rate limiting (défaut: 3 requêtes/min)
RATE_LIMIT_MAX_PER_MINUTE=3

# Paramètres géographiques SERP (défaut: us/en)
SERP_GL=us
SERP_HL=en

# ---------------------------------------------------------------------------
# DEBUG
# ---------------------------------------------------------------------------

# Optionnel — Active les logs détaillés
# DEBUG=true
